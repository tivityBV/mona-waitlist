{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/beta",
      "destination": "/api/beta"
    },
    {
      "source": "/android",
      "destination": "/api/android"
    }
  ],
  "headers": [
    {
      "source": "/beta-telefoon",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/en/beta-phone",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/assets/beta-qr.svg",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/wakker",
      "schedule": "0 6 * * *"
    }
  ]
}
